# ---- Next.js (copy to .env.local) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Written by `npx convex dev` for you:
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# ---- Convex deployment env (set with `npx convex env set NAME value`) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
# N8N_SHARED_SECRET=<long random string, same value as for n8n>
# N8N_WEBHOOK_URL=http://<n8n-host>:5678/webhook/lendloop-status

# ---- docker-compose (copy to .env next to docker-compose.yml) ----
# N8N_ENCRYPTION_KEY=<random>
# N8N_SHARED_SECRET=<same value as in Convex>
# CONVEX_SITE_URL=https://<deployment>.convex.site
